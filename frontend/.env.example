# Copy to `.env` and adjust.

# FastAPI base URL (include the /api prefix if your routers use one)
VITE_API_BASE_URL=http://localhost:8000/api

# true  = run entirely on local mock data (no backend needed)
# false = call the FastAPI backend
VITE_USE_MOCK=true

# Optional
VITE_MOCK_DELAY_MS=250
VITE_REQUEST_TIMEOUT_MS=20000
